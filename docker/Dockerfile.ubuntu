# The regression suites on Ubuntu 24.04 (Python 3.12, Ruby 3.2, PHP 8.3),
# laid out as on the dev VPS. Same entry point as the Debian image:
#   docker build -t speedrunner-ubuntu -f docker/Dockerfile.ubuntu docker
#   docker run --rm -t -v "$PWD:/src" speedrunner-ubuntu tests
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv ruby ruby-dev build-essential \
        php8.3-cli php8.3-opcache php8.3-xml php8.3-mbstring composer \
        cargo rustc zsh procps rsync git ca-certificates unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root/speedrunner
RUN python3 -m venv venv-aws && venv-aws/bin/pip install -q --no-cache-dir awscli \
    && python3 -m venv venv-test

COPY run.sh /usr/local/bin/speedrunner-dev
ENTRYPOINT ["speedrunner-dev"]
