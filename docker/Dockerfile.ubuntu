# The regression suites on Ubuntu: 24.04 (Python 3.12, Ruby 3.2, PHP 8.3) or,
# with --build-arg UBUNTU=22.04, Python 3.10, Ruby 3.0, PHP 8.1. Laid out as
# on the dev VPS, same entry point as the Debian image:
#   docker build -t speedrunner-ubuntu -f docker/Dockerfile.ubuntu docker
#   docker run --rm -t -v "$PWD:/src" speedrunner-ubuntu tests
# The layout is open to any uid, for a run as an unprivileged user:
#   docker run --rm -t --user 1000:1000 -e HOME=/tmp -v "$PWD:/src" speedrunner-ubuntu tests
ARG UBUNTU=24.04
FROM ubuntu:${UBUNTU}

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv ruby ruby-dev build-essential \
        php-cli php-opcache php-xml php-mbstring composer \
        cargo rustc zsh procps rsync git ca-certificates unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root/speedrunner
RUN python3 -m venv venv-aws && venv-aws/bin/pip install -q --no-cache-dir awscli \
    && python3 -m venv venv-test \
    && chmod 755 /root && chmod -R a+rwX /root/speedrunner

COPY run.sh /usr/local/bin/speedrunner-dev
ENTRYPOINT ["speedrunner-dev"]
