# Maintainer: speedrunner contributors <39555936+anthonyGosme@users.noreply.github.com>
# The release's static binary, as packaging/update.sh sets version and sums.
pkgname=speedrunner-bin
pkgver=0.4.4
pkgrel=1
pkgdesc="Python, Ruby, PHP and Node command-line tools, preloaded: each tool stays loaded in a daemon that forks it on every call"
arch=('x86_64' 'aarch64')
url="https://github.com/anthonyGosme/speedrunner"
license=('MIT OR Apache-2.0')
provides=('speedrunner')
conflicts=('speedrunner')
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/speedrunner-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/speedrunner-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('fe7e758f9f2fb23d872aa1a311662da7ff96856180d6b44eb22d913561c8da10')
sha256sums_aarch64=('91a365179f9ff729376853c04ceda33562bfa18b452ca6d046f515df22bb04d8')

package() {
  cd "speedrunner-$CARCH-unknown-linux-musl"
  install -Dm755 speedrunner "$pkgdir/usr/bin/speedrunner"
  ln -s speedrunner "$pkgdir/usr/bin/srr"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
